TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_with_api_hash
TELEGRAM_SESSION_PATH=.local/telegram.session

# Optional. Sending is disabled unless this is exactly true.
TELEGRAM_MCP_ENABLE_SEND=false

# Optional. Saving drafts (never sent) is disabled unless this is exactly true.
TELEGRAM_MCP_ENABLE_DRAFTS=false

# Optional for the login helper.
TELEGRAM_PHONE=+10000000000
TELEGRAM_PASSWORD=

# Optional: voice/video transcription (telegram_transcribe_voice). See docs/transcription.md.
# Local, offline (needs whisper-cli + ffmpeg on PATH or set below):
# WHISPER_MODEL_PATH=.local/models/ggml-large-v3-turbo-q5_0.bin
# WHISPER_CPP_BIN=whisper-cli
# FFMPEG_BIN=ffmpeg
# WHISPER_THREADS=4
# Or any OpenAI-compatible API (OpenAI, Groq, ...):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Optional: local | openai (default: local if a model is set, else openai if a key is set)
# TELEGRAM_MCP_TRANSCRIBE_BACKEND=
# Spoken language (ISO-639-1) or auto
# TELEGRAM_MCP_TRANSCRIBE_LANGUAGE=auto

# Optional: telegram_view_media. Videos larger than this return only their thumbnail.
# TELEGRAM_MCP_MAX_VIDEO_MB=50

# Optional: telegram_download_file. Folder files are saved to (~ allowed).
# TELEGRAM_MCP_DOWNLOAD_DIR=~/Downloads/Telegram MCP
